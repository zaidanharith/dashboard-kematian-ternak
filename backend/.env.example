PORT=5000

DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_url_here
DB_PASSWORD=your_db_password_here

JWT_SECRET=your_jwt_secret_here

GOOGLE_SECRET=your_google_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here

SUPABASE_EMAIL=your_supabase_email_here

# Integrasi dengan recording-ternak — JWT_SECRET & INTERNAL_API_KEY
# harus SAMA PERSIS dengan yang dipakai backend recording-ternak.
# Tabel users (SUPERADMIN dkk.) kini dikelola di recording-ternak, bukan di sini.
INTERNAL_API_KEY=your_shared_internal_api_key_here

# DEV (local) — backend recording-ternak default jalan di PORT=5000.
RECORDING_TERNAK_API_URL=http://localhost:5000
# PROD (Vercel) — set nilai di bawah ini di Vercel dashboard project dashboard-kematian-ternak,
# bukan di file .env:
# RECORDING_TERNAK_API_URL=https://api.recording.nirmalabesuki.com